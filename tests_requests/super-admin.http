### Configuration Variables
@baseUrl = http://localhost:3000
@contentType = application/json

# ==========================================
# 1. AUTHENTICATION (SUPER ADMIN)
# ==========================================

### Login as Super Admin
# @name loginSuperAdmin
POST {{baseUrl}}/auth/signin
Content-Type: {{contentType}}

{
  "email": "superadmin@timework.com",
  "password": "SuperPassword123!"
}

# ==========================================
# 2. COMPANIES MANAGEMENT
# ==========================================

### List all companies
GET {{baseUrl}}/super-admin/companies
Content-Type: {{contentType}}

### Get company by ID
GET {{baseUrl}}/super-admin/company/1
Content-Type: {{contentType}}

# ==========================================
# 3. PROVISIONING (CREATE COMPANY + MANAGER)
# ==========================================

### Provision a new Client (Company + Admin)
# Cette requête crée une entreprise, ses rôles et son manager principal.
# Le mot de passe du manager sera affiché dans la réponse et les logs du backend.
POST {{baseUrl}}/super-admin/provision
Content-Type: {{contentType}}
# Authorization: Bearer {{loginSuperAdmin.response.body.accessToken}}

{
  "companyName": "TechCorp Solutions",
  "operatingHours": {
    "monday": { "open": "09:00", "close": "17:00", "isOpen": true },
    "tuesday": { "open": "09:00", "close": "17:00", "isOpen": true },
    "wednesday": { "open": "09:00", "close": "17:00", "isOpen": true },
    "thursday": { "open": "09:00", "close": "17:00", "isOpen": true },
    "friday": { "open": "09:00", "close": "17:00", "isOpen": true },
    "saturday": { "open": "00:00", "close": "00:00", "isOpen": false },
    "sunday": { "open": "00:00", "close": "00:00", "isOpen": false }
  },
  "roles": [
    {
      "title": "Manager",
      "baseHourlyRate": 35.50,
      "staffingNeeds": { "monday": 1, "friday": 2 }
    },
    {
      "title": "Developer",
      "baseHourlyRate": 25.00,
      "staffingNeeds": { "monday": 5, "wednesday": 5 }
    }
  ],
  "managerEmail": "manager@techcorp.com",
  "managerFirstName": "Alice",
  "managerLastName": "Smith"
}

# ==========================================
# 3. COMPANY MANAGEMENT
# ==========================================

### Update Company Info
PATCH {{baseUrl}}/super-admin/company/1
Content-Type: {{contentType}}

{
  "address": "123 Innovation Drive, Tech City"
}

### Delete Company (Soft Delete)
DELETE {{baseUrl}}/super-admin/company/1
